{
  "rules": [
    {
      "id": "greeting",
      "keywords": [
        "你好",
        "hello",
        "hi",
        "嗨",
        "哈囉"
      ],
      "match_mode": "contains",
      "priority": 1,
      "cooldown_s": 2.0,
      "response": {
        "type": "speak_text",
        "text_template": "你好，我是語音助理"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "farewell",
      "keywords": [
        "再見",
        "掰掰",
        "拜拜",
        "下次見",
        "goodbye",
        "bye"
      ],
      "match_mode": "contains",
      "priority": 2,
      "cooldown_s": 2.0,
      "response": {
        "type": "speak_text",
        "text_template": "好的，再見！需要幫忙時隨時叫我。"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "thanks",
      "keywords": [
        "謝謝",
        "感謝",
        "謝啦",
        "thanks",
        "thank you"
      ],
      "match_mode": "contains",
      "priority": 3,
      "cooldown_s": 2.0,
      "response": {
        "type": "speak_text",
        "text_template": "不客氣，很高興能幫上忙。"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "goodnight",
      "keywords": [
        "晚安",
        "要睡了",
        "該睡了",
        "good night"
      ],
      "match_mode": "contains",
      "priority": 4,
      "cooldown_s": 2.0,
      "response": {
        "type": "speak_text",
        "text_template": "晚安，祝你今晚有個好夢。"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "weather",
      "keywords": [
        "天氣",
        "weather"
      ],
      "match_mode": "contains",
      "priority": 10,
      "cooldown_s": 5.0,
      "response": {
        "type": "speak_text",
        "text_template": "今天天氣晴朗，溫度適中"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "identity",
      "keywords": [
        "你是誰",
        "你叫什麼",
        "你叫什麼名字",
        "who are you"
      ],
      "match_mode": "contains",
      "priority": 6,
      "cooldown_s": 3.0,
      "response": {
        "type": "speak_text",
        "text_template": "我是你的語音助理，可以依照設定回答問題。"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "capabilities",
      "keywords": [
        "你會做什麼",
        "你能做什麼",
        "你可以做什麼",
        "能幫我什麼",
        "what can you do"
      ],
      "match_mode": "contains",
      "priority": 7,
      "cooldown_s": 3.0,
      "response": {
        "type": "speak_text",
        "text_template": "目前我能回應問候、天氣和時間等已設定的情境；天氣與時間回覆是預先設定的內容。"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "time",
      "keywords": [
        "時間",
        "幾點",
        "time"
      ],
      "match_mode": "contains",
      "priority": 20,
      "cooldown_s": 3.0,
      "response": {
        "type": "speak_text",
        "text_template": "現在時間是下午三點"
      },
      "tts": {
        "language": "zh-CN"
      }
    },
    {
      "id": "help",
      "keywords": [
        "幫助",
        "help",
        "救命"
      ],
      "match_mode": "contains",
      "priority": 5,
      "cooldown_s": 10.0,
      "response": {
        "type": "speak_text",
        "text_template": "我可以使用語音控制，說出關鍵字來觸發回應"
      },
      "tts": {
        "voice": "female",
        "language": "zh-CN"
      }
    }
  ]
}
